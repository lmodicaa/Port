<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/btn_adjust"
        android:layout_width="100dp"
        android:layout_height="54dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="18dp"
        android:layout_marginStart="18dp"
        android:text="Ajuste"
        android:background="#80000000"
        android:textColor="#FFFFFF" />

    <!-- Right Side Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="32dp"
        android:layout_marginEnd="64dp">

        <Button
            android:id="@+id/btn_jump"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="Jump"
            android:background="#80000000"
            android:textColor="#FFFFFF" />
            
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cash_calibration_panel"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="78dp"
        android:layout_marginStart="18dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#E6000000"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AJUSTE CASH"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/lbl_aim_sensitivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sensibilidad táctil"
            android:textColor="#FFFFFF" />

        <SeekBar
            android:id="@+id/seek_aim_sensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30"
            android:progress="14" />

        <TextView android:id="@+id/lbl_pos_x" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:text="Pos X: +0.00 m" />
        <SeekBar android:id="@+id/seek_pos_x" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="600" android:progress="300" />

        <TextView android:id="@+id/lbl_pos_y" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:text="Pos Y: +0.00 m" />
        <SeekBar android:id="@+id/seek_pos_y" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="600" android:progress="300" />

        <TextView android:id="@+id/lbl_pos_z" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:text="Pos Z: +0.00 m" />
        <SeekBar android:id="@+id/seek_pos_z" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="600" android:progress="300" />

        <TextView android:id="@+id/lbl_rot_x" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:text="Rot X: +0°" />
        <SeekBar android:id="@+id/seek_rot_x" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="360" android:progress="180" />

        <TextView android:id="@+id/lbl_rot_y" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:text="Rot Y: +0°" />
        <SeekBar android:id="@+id/seek_rot_y" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="360" android:progress="180" />

        <TextView android:id="@+id/lbl_rot_z" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:text="Rot Z: +0°" />
        <SeekBar android:id="@+id/seek_rot_z" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="360" android:progress="180" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_reset_adjust"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Reset" />

            <Button
                android:id="@+id/btn_copy_adjust"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Copiar" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
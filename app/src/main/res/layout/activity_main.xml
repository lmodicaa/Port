<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/btn_adjust"
        android:layout_width="100dp"
        android:layout_height="54dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="18dp"
        android:layout_marginStart="18dp"
        android:text="Ajuste"
        android:background="#80000000"
        android:textColor="#FFFFFF" />

    <!-- Right Side Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="32dp"
        android:layout_marginEnd="64dp">

        <Button
            android:id="@+id/btn_sprint"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:text="Sprint"
            android:background="#80000000"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_sneak"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:text="Sneak"
            android:background="#80000000"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_recenter"
            android:layout_width="80dp"
            android:layout_height="58dp"
            android:text="Centrar"
            android:background="#80000000"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_zoom"
            android:layout_width="80dp"
            android:layout_height="58dp"
            android:text="Zoom"
            android:background="#80000000"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_jump"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="Jump"
            android:background="#80000000"
            android:textColor="#FFFFFF" />
            
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cash_calibration_panel"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="78dp"
        android:layout_marginStart="18dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#E6000000"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AJUSTES"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/lbl_aim_sensitivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sensibilidad táctil"
            android:textColor="#FFFFFF" />

        <SeekBar
            android:id="@+id/seek_aim_sensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />
    </LinearLayout>
</FrameLayout>